{
  "name": "permafrost-backend",
  "version": "0.0.0",
  "description": "The backend server for the Permafrost Authentication Gateway.",
  "main": "src/index.ts",
  "author": "Snowflake-Software",
  "license": "All rights reserved",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "dev:hot": "bun run --hot src/index.ts",
    "build": "tsc -p tsconfig.build.json --outDir dist",
    "cli": "bun run src/cli.ts",
    "typecheck": "tsc --noEmit --strict",
    "start": "bun run src/index.ts",
    "run:and_migrate": "prisma migrate deploy && bun run start",
    "test": "vitest",
    "test-ci": "vitest --run"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/rate-limit": "10.2.1",
    "@fastify/static": "^8.0.3",
    "@prisma/client": "^6.1.0",
    "@simplewebauthn/server": "^13.0.0",
    "citty": "^0.1.6",
    "fast-geoip": "1.1.88",
    "fast-querystring": "^1.1.2",
    "fastify": "^5.2.0",
    "fastify-file-upload": "^4.0.0",
    "fastify-plugin": "^5.0.1",
    "file-type": "^19.6.0",
    "ioredis": "^5.4.2",
    "ipaddr.js": "2.2.0",
    "jsonwebtoken": "^9.0.2",
    "lowdb": "^7.0.1",
    "luxon": "3.5.0",
    "node-cache": "^5.1.2",
    "nodemailer": "^6.9.16",
    "otpauth": "^9.3.6",
    "prom-client": "^15.1.3",
    "superjson": "^2.2.2",
    "ua-parser-js": "^2.0.0",
    "yoctocolors": "^2.1.1",
    "zod": "^3.25.74"
  },
  "devDependencies": {
    "@snowflake-software/typescript-config": "workspace:*",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/luxon": "3.4.2",
    "@types/nodemailer": "^6.4.17",
    "@vitest/ui": "^3.2.4",
    "prisma": "^6.1.0",
    "vitest": "^3.2.4"
  }
}
